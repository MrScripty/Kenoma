  "quality_policy": {
    "policy_origin": "Authored curation gates for this milestone; not source-provided clinical thresholds.",
    "identity": "Exact source-byte hashes, same male specimen and explicit acquisition-state/series per asset; no silent source or side substitutions.",
    "geometry": "Record original dimensions, row/column/slice indexing, pixel-center convention, sampling, orientation and origin. A CT header cannot supply the cryosection affine.",
    "roi": "Verified laterality and explicit pixel bounds on source slices before an arm-region claim. Scouts are not an elbow volume.",
    "annotation": "Annotator/reviewer provenance, visible-boundary citations and per-target status. Unknown voxels remain unknown, rather than background or invented tissue.",
    "contrast": "Classify boundaries only where visible in source pixels; color or intensity alone is not a tissue identity rule.",
    "partial_volume": "Report unresolved interfaces separately; do not merge fat with fascia/skin or cartilage with bone to claim tissue distinction.",
    "continuity": "For a 3D annotation, inspect contiguous source slices, report gaps and mark interpolation as reconstructed rather than directly observed.",
    "review": "Independent anatomical review, label exclusivity, per-target disagreement/uncertainty maps and source-linked corrections; topology is not an anatomical correctness test.",
    "sampling": "Compare feature extent with axis-specific sampling, preserve thin-layer uncertainty; neither voxel size nor half a voxel is a certified segmentation error.",
    "registration": "Any normal/frozen CT, MRI or color alignment requires a source-bound transform and measured residuals; shared specimen/filenames do not imply registration.",
    "quantities": "Do not infer fibre fields, material laws, enthesis architecture or tendon attachment forces from coarse tissue labels.",
    "release": "Retain attribution, provenance, missing-data states and a conspicuous version/accuracy notice. This checkpoint is not currentness or clinical validation."
  }
